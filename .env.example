# Copy this file to .env.local and fill in the two values from your Supabase project:
# Supabase dashboard -> your project -> "Connect" button (or Project Settings -> API Keys).

# Project URL, looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with sb_publishable_ (the legacy "anon" key also works here).
# Never put the secret / service_role key in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth Web client ID (ends in .apps.googleusercontent.com). Public, not a secret.
# Powers Google's own sign-in button, so Google's screen says "continue to <your site>".
# The client SECRET goes only in supabase/.env, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
